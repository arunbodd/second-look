# Copy to .env and edit. Every setting is optional: with no .env the app runs fully offline.

# ---- Keys for the Models menu --------------------------------------------------------
# With one of these set you can pick the writer and judge in the UI (Models menu); the
# LLM_* / JUDGE_* settings below are optional defaults.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# One Perplexity key reaches OpenAI, Anthropic, and Google models through its Agent API
PERPLEXITY_API_KEY=

# ---- Narrative writer (the "generator") ----------------------------------------------
# offline | openai | anthropic | perplexity | litellm
LLM_PROVIDER=offline
# Model name for the provider, for example claude-sonnet-5, gpt-4.1-mini, or qwen2.5:7b-instruct
LLM_MODEL=
# OpenAI-compatible base URL. Leave empty for api.openai.com. Examples:
#   Ollama     http://localhost:11434/v1
#   LM Studio  http://localhost:1234/v1
#   OpenRouter https://openrouter.ai/api/v1
LLM_BASE_URL=
# API key for the provider (ANTHROPIC_API_KEY / OPENAI_API_KEY are also read)
LLM_API_KEY=
LLM_TIMEOUT=90
LLM_TEMPERATURE=0.2
# Reasoning models (GPT-5, GPT-6): low keeps hidden reasoning tokens, which are billed as output, down
LLM_REASONING_EFFORT=low

# ---- LLM-as-judge ----------------------------------------------------------------
# Defaults to the generator's provider and model. Use a different model family for an
# independent review (the app warns when both are the same model).
JUDGE_PROVIDER=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
# Set to false to run rule-based checks only
JUDGE_ENABLED=true
# How many times a flagged narrative is sent back for revision before it is published or replaced
JUDGE_MAX_REVISIONS=1
# Judge chat answers on request
JUDGE_CHAT=true

# ---- App -----------------------------------------------------------------------------
# Review every case with the model at startup instead of waiting for "Run" in the AI review tab
PRECOMPUTE=false
LLM_MAX_CONCURRENCY=3
DATA_PATH=data/sample_cases_synthetic.csv
DB_PATH=data/triage.db
